# Application Configuration
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Storage
DATABASE_URL=sqlite+aiosqlite:///./storage/studio.db
STORAGE_LOCAL_DIR=./storage

# AI Providers Config
# Available: "mock", "openai", "gemini", "anthropic", "stability", "local"
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock

# Real Provider API Keys (Leave blank for offline mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
LOCAL_DIFFUSION_ENDPOINT=http://127.0.0.1:7860

# Background Job Worker
WORKER_POLL_INTERVAL_SECONDS=1.0
MAX_CONCURRENT_JOBS=4
